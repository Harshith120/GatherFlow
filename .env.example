# Copy these settings into your ignored local .env file.
# For an existing database volume, this must match the database role password.
POSTGRES_PASSWORD=replace-with-a-strong-password

# These let a Node.js process on Windows connect to the Compose database.
PGHOST=localhost
PGPORT=5433
PGUSER=gatherflow
PGDATABASE=gatherflow

# Optional Resend settings.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=GatherFlow <no-reply@your-verified-domain.com>
# For shareable links, replace localhost with the public URL routed to GatherFlow.
APP_BASE_URL=http://localhost:3000
